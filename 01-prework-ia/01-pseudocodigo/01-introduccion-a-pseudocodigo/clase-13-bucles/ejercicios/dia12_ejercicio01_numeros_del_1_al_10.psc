//Ejercicio 1
//Enunciado:	
//	Escribe un programa que muestre los números del 1 al 10 usando MIENTRAS.
		
Algoritmo dia12_ejercicio01_numeros_del_1_al_10	
	Definir contador Como Entero	
	contador = 1
	
	Mientras contador <= 10 Hacer
		Escribir contador
		contador = contador + 1
	FinMientras
	
FinAlgoritmo
