//Ejercicio 2 Media de tres números
//
//Enunciado
//Escribe un programa que:
//	Pida tres números
//	Calcule su media
//	Muestre el resultado
	
Algoritmo dia07_ejercicio02_media_de_tres_numeros
	
	Definir numero1, numero2, numero3, media Como Real
	
	Escribir Sin Saltar 'Por favor ingresar el primer número: '
	Leer numero1
	Escribir Sin Saltar 'Por favor ingresar el segundo número: '
	Leer numero2
	Escribir Sin Saltar 'Por favor ingresar el tercer número: '
	Leer numero3
		
	media = (numero1 + numero2 + numero3)/3
	
	Escribir ''
	Escribir 'El resultado de la media es: ', media
	
FinAlgoritmo
