Algoritmo dia02_ejercicio02_presentacion_personal
	
    Definir nombre, ciudad_nacimiento Como Caracter
    Definir edad Como Entero
	
    Escribir Sin Saltar "Introduce tu nombre: "
    Leer nombre
	
    Escribir  Sin Saltar "Introduce tu edad: "
    Leer edad
	
    Escribir  Sin Saltar "Introduce tu ciudad de nacimiento: "
    Leer ciudad_nacimiento
	
    Escribir ""
    Escribir "Hola, mi nombre es ", nombre, "."
    Escribir "Tengo ", edad, " años."
    Escribir "Nací en ", ciudad_nacimiento, "."
	
FinAlgoritmo
